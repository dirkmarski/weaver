#!/bin/bash
# Launch the weaver agent team on one task, or on the next iteration.
#
#   .claude/run-task <issue-number>           start "complete task #<n>"
#   .claude/run-task --iteration              start "deliver the next iteration"
#   .claude/run-task --check <issue-number>   run every check, print the launch, start nothing
#   .claude/run-task --check --iteration      the same, for an iteration
#
# Run it from Dirk's clone. The team works in its own clone (WEAVER_TEAM_DIR, default
# ~/Code/weaver-team), never in his. Before starting, the script:
#   - refuses while Dirk's .claude/ or governance/ has changes not committed AND pushed,
#     so every run is tied to a published set of definitions;
#   - creates the team clone if missing, and fast-forwards it to origin/main when it is
#     clean and on main (otherwise it leaves the team's unfinished work alone);
#   - refuses if the team clone's .claude/ or governance/ differ from Dirk's;
#   - gives the session a fixed id: launched with --session-id and exported as
#     WEAVER_SESSION_ID, so agents tag their work with the id of the real transcript;
#   - gives the session temp folders of its own under /tmp/wvr (step 8);
#   - writes the team identity into the team clone's own git config. Claude Code strips
#     every GIT_CONFIG_* variable from its own git calls, so only repo config reaches the
#     session-start snapshot. The env block of launch-settings.json stays the single
#     source of the identity and still covers the agents' own git commands.

set -euo pipefail

die() { echo "run-task: $*" >&2; exit 1; }

usage="usage: run-task [--check] <issue-number> | run-task [--check] --iteration"
check_only=0
if [ "${1:-}" = "--check" ]; then check_only=1; shift; fi
[ $# -eq 1 ] || die "$usage"
if [ "$1" = "--iteration" ]; then
  prompt="deliver the next iteration"
  label="next iteration"
else
  case "$1" in
    ''|*[!0-9]*) die "$usage" ;;
  esac
  prompt="complete task #$1"
  label="task #$1"
fi

repo="$(cd -P "$(dirname "$0")/.." && pwd)"
team="${WEAVER_TEAM_DIR:-$HOME/Code/weaver-team}"
settings=".claude/launch-settings.json"
cd "$repo"

command -v claude >/dev/null || die "claude is not on PATH"
command -v jq >/dev/null || die "jq is not on PATH"
[ -f "$settings" ] || die "missing $settings"
# The session's top agent. The director launches the product manager and one lead per
# issue (from iteration 17, 21 Oct 2026); until then the lead ran the whole iteration.
top_agent="director"
[ -f ".claude/agents/$top_agent.md" ] || die "missing .claude/agents/$top_agent.md"
[ "$team" != "$repo" ] || die "the team clone cannot be Dirk's clone"

# 1. Definitions must be committed and pushed.
if [ -n "$(git status --porcelain -- .claude governance)" ]; then
  echo "run-task: uncommitted changes under .claude/ or governance/ - commit them first:" >&2
  git status --short -- .claude governance >&2
  exit 1
fi
git fetch -q origin main || die "cannot fetch origin"
git diff --quiet HEAD origin/main -- .claude governance \
  || die "your .claude/ or governance/ differs from origin/main - push (or pull) first"
defs="$(git log -1 --format=%h -- .claude governance)"

# 2. The team's clone: create it, or reset it to main. GitHub is the team's durable
#    record, so the clone is disposable - unless it holds work that exists nowhere else
#    (uncommitted changes, or commits on no remote branch). That is left for the lead.
if [ ! -d "$team/.git" ]; then
  [ ! -e "$team" ] || die "$team exists but is not a git clone"
  git clone -q -b main "$(git remote get-url origin)" "$team" || die "cannot clone into $team"
fi
git -C "$team" fetch -q --prune origin || die "cannot fetch origin in $team"
if [ -z "$(git -C "$team" status --porcelain)" ] \
   && [ -z "$(git -C "$team" log --branches --not --remotes --format=%h)" ]; then
  git -C "$team" checkout -q main && git -C "$team" merge -q --ff-only origin/main \
    || die "cannot bring the team clone's main up to origin/main"
else
  echo "run-task: team clone holds unsaved work on '$(git -C "$team" branch --show-current)' - left for the lead to resume"
fi

# 3. The team must run on Dirk's definitions, unaltered.
git -C "$team" diff --quiet origin/main -- .claude governance \
  && [ -z "$(git -C "$team" status --porcelain -- .claude governance)" ] \
  || die "the team clone's .claude/ or governance/ differs from origin/main - not launching"

# 4. The team's token, from the keychain. Never printed.
GH_TOKEN="$(security find-generic-password -s weaver-agents-token -w 2>/dev/null)" \
  || die "no keychain item 'weaver-agents-token'"
[ -n "$GH_TOKEN" ] || die "keychain item 'weaver-agents-token' is empty"
export GH_TOKEN

# 5. The team's git identity: into the team clone's config for the session-start
#    snapshot, and exported for everything else. Source: launch-settings.json.
for key in user.name user.email; do
  value="$(jq -r --arg k "$key" '(.env // {}) as $e | [$e | to_entries[]
    | select(.key | startswith("GIT_CONFIG_KEY_")) | select(.value == $k)
    | $e[.key | sub("KEY"; "VALUE")]] | .[0] // empty' "$settings")"
  [ -n "$value" ] || die "$settings sets no $key"
  git -C "$team" config "$key" "$value"
done
eval "$(jq -r '.env // {} | to_entries[] | "export \(.key)=\(.value | @sh)"' "$settings")"

# 6. Confirm the identity resolves to the team, both as the snapshot sees it (no
#    GIT_CONFIG_* variables) and as the agents' commands see it.
[ "$(env -u GIT_CONFIG_COUNT -u GIT_CONFIG_PARAMETERS git -C "$team" config user.name)" = "weaver-agents" ] \
  || die "the team clone's own config does not name weaver-agents"
[ "$(git -C "$team" config user.name)" = "weaver-agents" ] || die "git user is not weaver-agents"
login="$(gh api user --jq .login 2>/dev/null)" || die "the token was rejected by GitHub"
[ "$login" = "weaver-agents" ] || die "the token belongs to '$login', not weaver-agents"

# 7. The session id: one UUID, used by Claude Code for the transcript and exported for
#    the agents' commands, so commits and pull requests trace back to the transcript.
WEAVER_SESSION_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"
export WEAVER_SESSION_ID

# 8. Temp folders of the team's own. In iteration 13 a failed command chain left an
#    agent's `rm -rf $TMPDIR` pointing at the Mac's system temp folder. Here a default
#    TMPDIR is a per-session folder, so a delete like that reaches only the team's temp.
#    CLAUDE_CODE_TMPDIR moves Claude Code's own temp and scratchpads out of the folder
#    every Claude session shares; it must stay short (about 30 bytes, socket paths) or
#    Claude Code ignores it. Chrome on macOS takes MAC_CHROMIUM_TMPDIR, not TMPDIR.
#    macOS mktemp ignores TMPDIR and still creates under the system temp folder.
#    Tested 21 Oct 2026 on 2.1.304: 167/167 tests, page tests included.
export CLAUDE_CODE_TMPDIR="/tmp/wvr"
export TMPDIR="$CLAUDE_CODE_TMPDIR/tmp-${WEAVER_SESSION_ID:0:8}"
export MAC_CHROMIUM_TMPDIR="$TMPDIR"

echo "run-task: $label, definitions at $defs, session $WEAVER_SESSION_ID, team clone $team, $(claude --version)"

# 9. Print mode (-p): the session exits by itself once the top agent has finished, after
#    waiting for its background agents, and the exit writes Claude Code's cost record
#    (tested 21 Oct 2026, 2.1.304). Nothing shows on screen until the end - the top agent's
#    final summary - so follow the run in the transcript.
cmd=(claude -p --agent "$top_agent" --settings "$team/$settings" --permission-mode auto --session-id "$WEAVER_SESSION_ID" "$prompt")
transcript="$HOME/.claude/projects/$(printf '%s' "$team" | tr '/.' '--')/$WEAVER_SESSION_ID.jsonl"
if [ "$check_only" = 1 ]; then
  echo "run-task: checks passed - would run in $team: ${cmd[*]}"
  echo "run-task: transcript would be $transcript, temp $TMPDIR"
  exit 0
fi
echo "run-task: running in print mode, exits when done; transcript $transcript"

# 10. Remove the session's temp folder when the run ends, however it ends. Chrome
#     leaves its profile and socket folders behind (about 155 items, 14 MB in
#     iteration 14). The pattern check keeps the delete inside /tmp/wvr/tmp-*.
cleanup() {
  case "$TMPDIR" in
    /tmp/wvr/tmp-?*) rm -rf "$TMPDIR" ;;
    *) echo "run-task: not removing unexpected temp folder '$TMPDIR'" >&2 ;;
  esac
}
mkdir -p "$TMPDIR"
trap cleanup EXIT
cd "$team"
status=0
"${cmd[@]}" < /dev/null || status=$?
exit "$status"
